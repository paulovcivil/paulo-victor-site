FLASK_APP=app.py
FLASK_DEBUG=True
SECRET_KEY=replace-with-your-own-secret-key

# Gmail address used to send contact form notifications (needs an App Password, not your normal password)
MAIL_USERNAME=youraddress@gmail.com
MAIL_PASSWORD=replace-with-a-gmail-app-password
# Optional: where notifications are sent, if different from MAIL_USERNAME
MAIL_TO=youraddress@gmail.com
