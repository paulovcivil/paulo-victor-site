FLASK_APP=app.py
FLASK_DEBUG=True
SECRET_KEY=replace-with-your-own-secret-key

# Resend (resend.com) API key, used to send contact form notifications by email
RESEND_API_KEY=replace-with-your-resend-api-key
# Where notifications are sent — on the free Resend plan (no custom domain verified),
# this must be the same email address used to sign up for Resend
MAIL_TO=youraddress@gmail.com
